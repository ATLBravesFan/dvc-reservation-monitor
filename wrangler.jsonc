{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dvc-reservation-monitor",
  "main": "src/index.js",
  "compatibility_date": "2026-10-10",
  "triggers": {
    "crons": ["* * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dvc-monitor-state",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "EMAIL_FROM_NAME": "DVC Monitor"
  }
}
